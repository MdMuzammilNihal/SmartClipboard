# Smart Clipboard .gitignore
# This file must be the first commit (CLAUDE.md section 11, pitfall 9).
# The app keeps its real data under %LOCALAPPDATA%\SmartClipboard\, outside
# the repo. The patterns below are a second line of defence in case a
# database, log, or private file ever lands inside the working tree.

# --- Databases and encrypted stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dpapi

# --- Logs and crash output ---
*.log
logs/
crash/
*.dmp

# --- Private data (labeled-data log, real clipboard samples, mislabel notes) ---
private/
data/
*.private.*
labeled_items*

# --- Local config and secrets ---
.env
.env.*
config.local.*

# --- Virtual environments ---
.venv/
venv/
env/

# --- Python build and cache ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# --- Editors and OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Claude Code planning files and local settings (kept on the owner's machine only) ---
CLAUDE.md
PHASE2.md
.claude/settings.local.json

# --- Owner's personal tracker spreadsheets ---
docs/*.xlsx
